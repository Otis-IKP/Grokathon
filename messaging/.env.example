ANTHROPIC_API_KEY=           # your Claude API key (platform.claude.com). Never commit .env.
CLAUDE_MODEL=claude-opus-5-5 # checked against the Models API at startup
CLAUDE_EFFORT=low            # low | medium | high | xhigh | max. Low keeps text replies quick.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=        # E.164, e.g. +15551234567
WEBHOOK_SECRET=              # random string, required as ?secret= on the webhook URL
BACKEND_MODE=mock            # mock | http
BACKEND_URL=                 # NEPO app origin, e.g. http://localhost:3000. Used when BACKEND_MODE=http
BACKEND_API_SECRET=          # same value as the app's BOT_API_SECRET; required when BACKEND_MODE=http
                             # The app's BOT_WEBHOOK_URL should point at {this bot}/webhooks/app
SIGNUP_URL=https://example.com/signup  # must be the app's sign-in page (e.g. {APP_URL}/login) when BACKEND_MODE=http
PUBLIC_BASE_URL=             # no trailing slash; cloudflared or ngrok URL, so the draft link is https
PORT=3001                    # the app uses 3000
DRY_RUN=false                # true = log outbound texts instead of calling Sendblue

# Optional. Overrides the fictional 555 numbers so real phones can play the demo.
DEMO_MAYA_PHONE=
DEMO_ALSO_PHONES=            # comma-separated real phones that should use Maya's demo graph
DEMO_JORDAN_PHONE=
DEMO_PRIYA_PHONE=
DEMO_SAM_PHONE=
