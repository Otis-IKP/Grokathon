# Database. Two forms are accepted:
#   pglite://./.data/pg   embedded Postgres (PGlite) stored in a local folder. No install needed.
#                         Only one process can open it, so while `pnpm dev` is running the
#                         scripts (seed, worker, ...) talk to the dev server instead.
#   postgres://...        real Postgres: Neon, Supabase or Docker. Use this in production.
DATABASE_URL=pglite://./.data/pg
# Public origin, no trailing slash. Used for the CAS service URL and intro links.
APP_URL=http://localhost:3000
# 32+ random characters used to encrypt the session cookie. `openssl rand -base64 32`
SESSION_SECRET=change-me-change-me-change-me-change-me
# Yalies API key (https://yalies.io/apidocs after signing in with a NetID). Required when MOCK_EXTERNAL is not 1.
YALIES_API_KEY=
# Optional override of the Yalies base URL.
YALIES_BASE_URL=https://api.yalies.io/v2
# xAI API key (https://console.x.ai). Required when MOCK_EXTERNAL is not 1.
XAI_API_KEY=
# Model id for research agents. Check https://docs.x.ai/docs/models for the current one.
XAI_MODEL=grok-4.7
# Cheaper model for extraction and drafting. Defaults to XAI_MODEL.
XAI_MODEL_FAST=
# Shared secret Tobi's bot sends as `Authorization: Bearer ...`.
BOT_API_SECRET=dev-bot-secret
# The NEPO number shown on the phone-linking screen.
BOT_PHONE_DISPLAY=+1 645 243 7121
# Comma-separated NetIDs allowed into /admin.
ADMIN_NETIDS=demo_maya
# Protects POST /api/internal/jobs/tick (sent as a bearer token by the cron).
CRON_SECRET=dev-cron-secret
# The website's origin (website/, deployed at yalenepo.xyz), for CORS on the public graph endpoint.
WEBSITE_ORIGIN=https://yalenepo.xyz
# The bot's /webhooks/app route, so a requester gets a text when a connector answers in the app.
# With vercel.json's services setup: {APP_URL}/bot/webhooks/app. Optional.
BOT_WEBHOOK_URL=
# 1 = never call Yalies or xAI; serve fixtures from tests/fixtures. Default in tests.
MOCK_EXTERNAL=1
# 1 = show a "sign in as NetID" form that skips CAS. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=1
# Global cap on agent jobs started per hour.
ENRICH_MAX_JOBS_PER_HOUR=120
# Re-research a person at most this often (days).
ENRICH_PERSON_TTL_DAYS=30
# Re-crawl a club roster at most this often (days).
ENRICH_CLUB_TTL_DAYS=14
# Only for the optional "Sign in with LinkedIn" badge (not implemented; P2).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
