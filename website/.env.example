# Copy to .env (gitignored) for local work; set the same names in Vercel for production.
# The app's public origin, no trailing slash. Leave empty until the app is deployed.
PUBLIC_APP_URL=
# A path share token from the app, to show a real path on /how instead of the sample. Tokens last 24 hours.
PUBLIC_GRAPH_SHARE_TOKEN=
# The number students text.
PUBLIC_BOT_PHONE=+1 645 243 7121
