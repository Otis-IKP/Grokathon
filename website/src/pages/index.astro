---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import YMark from "../components/YMark.astro";
import { botPhone, loginUrl, smsHref } from "../lib/config";

const steps = [
  {
    title: "Text the club you want",
    body: "Message NEPO something like “I want to be on YSIG.” Any club works, by its full name or its initials.",
  },
  {
    title: "See your warmest way in",
    body: "NEPO looks at the friends you’ve added and who they know in that club, then tells you who to ask and why.",
  },
  {
    title: "Send the ask, or don’t",
    body: "It drafts a short text in your voice. Nothing goes out until you say so, and your friend can say no with one tap.",
  },
];
---

<Base
  title="Yale NEPO · Get into clubs through people you already know"
  description="Text NEPO the Yale club you want. It finds the friend best placed to introduce you and drafts the ask."
>
  <section class="wrap hero-wrap">
    <div class="hero">
      <div class="hero-copy">
        <p class="hero-eyebrow">For Yale students</p>
        <h1>Get into clubs through people you already know.</h1>
        <p class="hero-lede">
          Text NEPO the club you want. It finds the friend best placed to introduce you, and drafts the ask.
        </p>
        <div class="hero-actions">
          <a class="btn btn-light" href={smsHref}>Text NEPO</a>
          {
            loginUrl ? (
              <a class="btn btn-ghost" href={loginUrl}>
                Sign in with Yale
              </a>
            ) : (
              <a class="btn btn-ghost" href="/how">
                How it works
              </a>
            )
          }
        </div>
        <p class="hero-number">NEPO’s number is <a href={smsHref}>{botPhone}</a></p>
      </div>
      <Photo
        class="hero-photo"
        src="/images/yale-harkness.jpg"
        alt="Harkness Tower seen through summer trees on Old Campus"
        width={1200}
        height={800}
        credit="Harkness Tower. Carol M. Highsmith, Library of Congress"
        creditHref="https://commons.wikimedia.org/wiki/File:Harkness_Tower_Canopy_Highsmith.jpg"
        priority
      />
      <YMark />
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">How it works</p>
    <h2 class="section-title">Three steps</h2>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="more"><a href="/how">Read how NEPO finds a path, and what it keeps private</a></p>
  </section>
</Base>

<style>
  .hero-wrap {
    padding-top: 8px;
  }
  .hero {
    position: relative;
    display: grid;
    gap: 28px;
    background: var(--yale);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 36px 24px 84px;
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
      gap: 48px;
      padding: 64px 56px 72px;
    }
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5.4vw, 54px);
  }
  .hero-lede {
    margin-top: 18px;
    font-size: 19px;
    color: rgba(255, 255, 255, 0.86);
    max-width: 38ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-number {
    margin-top: 16px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero-number a {
    color: #fff;
  }
  .hero :global(.hero-photo) {
    max-width: 440px;
  }
  .hero :global(.hero-photo figcaption),
  .hero :global(.hero-photo figcaption a) {
    color: rgba(255, 255, 255, 0.65);
  }
  .steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .step {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--yale-soft);
    color: var(--yale);
    font-weight: 700;
    font-size: 15px;
  }
  .step h3 {
    margin-top: 16px;
    font-size: 21px;
  }
  .step p {
    margin-top: 8px;
    color: var(--muted);
  }
  .more {
    margin-top: 24px;
    font-weight: 600;
  }
</style>
