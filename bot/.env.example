# === Grok / xAI (REQUIRED — Grok only for this hackathon) ===
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Prefer a Grok model available on your X Premium / xAI key tonight
GROK_MODEL=grok-4-fast-reasoning

# === Server ===
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# ngrok / cloudflare tunnel URL once live, e.g. https://xxxx.ngrok.app
WEBHOOK_BASE_URL=

# === Messaging provider ===
# Options: local | sendblue | linq | loopmessage | twilio_sms
MESSAGING_PROVIDER=local
MESSAGING_WEBHOOK_SECRET=dev-secret-change-me

# Sendblue (iMessage API) — fill if using Sendblue
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# Linq (iMessage) — fill if using Linq
LINQ_API_TOKEN=
LINQ_FROM_NUMBER=

# LoopMessage — fill if using LoopMessage
LOOPMESSAGE_AUTH_KEY=
LOOPMESSAGE_SECRET_KEY=
LOOPMESSAGE_SENDER_NAME=

# Twilio SMS fallback (not iMessage, but works for demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Otis backend API ===
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=
# Set true to use in-memory seeded demo graph instead of Otis API
USE_STUB_BACKEND=true

# === Demo identity (maps inbound phone → user) ===
DEMO_USER_PHONE=+12035550100
DEMO_USER_ID=user_maya
